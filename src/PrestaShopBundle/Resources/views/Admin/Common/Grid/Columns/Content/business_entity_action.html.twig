{% set actions = column.options.actions %}

{% if actions is not empty %}
  {% set inlineActions = [] %}
  {% set regularActions = [] %}
  {% set deleteAction = null %}

  {% for action in actions %}
    {% if action.isApplicable(record) %}
      {% if action.options['use_inline_display'] == true %}
        {% set inlineActions = inlineActions|merge([action]) %}
      {% elseif action.id == 'delete' %}
        {% set deleteAction = action %}
      {% else %}
        {% set regularActions = regularActions|merge([action]) %}
      {% endif %}
    {% endif %}
  {% endfor %}

  <div class="btn-group-action text-center business-entity-actions">
    {% if inlineActions is not empty %}
      <div class="btn-group btn-group-inline d-flex justify-content-center">
        {% for inlineAction in inlineActions -%}
          {% set class = 'inline-dropdown-item ' ~ inlineAction.options.attr.class|default('') %}

          {{ include('@PrestaShop/Admin/Common/Grid/Actions/Row/' ~ inlineAction.type ~ '.html.twig', {
            grid: grid,
            column: column,
            attributes: {class: class|trim, tooltip_name: true},
            record: record,
            action: inlineAction,
          }) }}
        {% endfor %}
      </div>
    {% endif %}

    {% if regularActions is not empty or deleteAction %}
      <div class="btn-group">
        <a class="btn btn-link dropdown-toggle no-rotate business-entity-actions-toggle"
           data-toggle="dropdown"
           aria-haspopup="true"
           aria-expanded="false"
        >
          <i class="material-icons">more_horiz</i>
        </a>

        <div class="dropdown-menu dropdown-menu-right">
          {% for action in regularActions %}
            {{ include('@PrestaShop/Admin/Common/Grid/Actions/Row/' ~ action.type ~ '.html.twig', {
              grid: grid,
              column: column,
              attributes: {class: 'dropdown-item', tooltip_name: false},
              record: record,
              action: action,
            }) }}
          {% endfor %}

          {% if deleteAction %}
            {% if regularActions is not empty %}
              <div class="dropdown-divider"></div>
            {% endif %}
            {{ include('@PrestaShop/Admin/Common/Grid/Actions/Row/' ~ deleteAction.type ~ '.html.twig', {
              grid: grid,
              column: column,
              attributes: {class: 'dropdown-item business-entity-action-delete', tooltip_name: false},
              record: record,
              action: deleteAction,
            }) }}
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>
{% endif %}
