<div class="card" data-role="business-entity">
  <h3 class="card-header">
    {{ 'Company information'|trans({}, 'Admin.Global') }}
  </h3>

  <div class="card-body">
    <div class="row">
      <div class="col-md-6">
        <div class="text-muted mb-3">{{ 'Name'|trans({}, 'Admin.Global') }}</div>
        <div class="mb-3"><strong>{{ businessEntity.getName }}</strong></div>
      </div>
      <div class="col-md-6">
        <div class="text-muted mb-3">{{ 'Legal name'|trans({}, 'Admin.Global') }}</div>
        <div class="mb-3"><strong>{{ businessEntity.getLegalName ?: '-' }}</strong></div>
      </div>
    </div>
    <hr>
    <div class="row">
      <div class="col-md-4">
        <div class="text-muted mb-3">{{ 'VAT number'|trans({}, 'Admin.Global') }}</div>
        <div class="mb-3"><strong>{{ businessEntity.getInvoiceAddress ?  businessEntity.getInvoiceAddress.getVatNumber : '-' }}</strong></div>
      </div>
      <div class="col-md-4">
        <div class="text-muted mb-3">{{ 'SIREN/SIRET'|trans({}, 'Admin.Global') }}</div>
        <div class="mb-3"><strong>{{ '-' }}</strong></div>
      </div>
      <div class="col-md-4">
        <div class="text-muted mb-3">{{ 'DUNS'|trans({}, 'Admin.Global') }}</div>
        <div class="mb-3"><strong>{{ '-' }}</strong></div>
      </div>
    </div>
    <hr>
    <div class="row">
      <div class="col-md-4">
        <div class="text-muted small">{{ 'Status'|trans({}, 'Admin.Global') }}</div>
        <div class="mb-0">{{ businessEntity.getStatus|capitalize }}</div>
      </div>
    </div>
  </div>
</div>
