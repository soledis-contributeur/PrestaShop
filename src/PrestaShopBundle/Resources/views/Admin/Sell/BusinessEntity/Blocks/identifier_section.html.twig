{% form_theme businessEntityForm '@PrestaShop/Admin/TwigTemplateForm/prestashop_ui_kit_base.html.twig' %}

<hr>
{{ form_row(businessEntityForm.business_identifier_selector) }}
<div class="row business_entity_identifiers js-business-entity-identifiers"
     data-index="{{ businessEntityForm.identifiers|length }}"
     data-check-duplicate-url="{{ path('admin_business_entities_check_duplicate_identifier') }}"
     data-business-entity-id="{{ businessEntityId|default('') }}"
     data-prototype="{{ include('@PrestaShop/Admin/Sell/BusinessEntity/Blocks/identifier_row.html.twig', {identifier: businessEntityForm.identifiers.vars.prototype})|e('html_attr') }}">
  {% for identifier in businessEntityForm.identifiers %}
    {{ include('@PrestaShop/Admin/Sell/BusinessEntity/Blocks/identifier_row.html.twig', {identifier: identifier}) }}
  {% endfor %}
</div>
<button type="button" class="btn btn-outline-secondary mt-2 mb-3 js-business-entity-identifier-add" disabled>
  <i class="material-icons">add</i>{{ 'Add business ID'|trans({}, 'Admin.Global') }}
</button>
