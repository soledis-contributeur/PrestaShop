{% set status = businessEntity.getStatus %}
{% set statusLabel = status|capitalize %}

{% set badgeClass = 'badge-secondary' %}
{% if status == 'active' %}
  {% set badgeClass = 'badge-success' %}
{% elseif status == 'pending' %}
  {% set badgeClass = 'badge-warning' %}
{% elseif status == 'rejected' %}
  {% set badgeClass = 'badge-danger' %}
{% elseif status == 'inactive' %}
  {% set badgeClass = 'badge-secondary' %}
{% endif %}

<div class="row mb-3">
  <div class="col">
    <div class="d-flex justify-content-between align-items-start">
      <div>
        <h1 class="mb-0">
          {{ businessEntity.getName }}
          <span class="badge {{ badgeClass }} ml-2">{{ statusLabel }}</span>
        </h1>
        {% if businessEntity.getLegalName %}
          <div class="text-muted">{{ businessEntity.getLegalName }}</div>
        {% endif %}
      </div>
    </div>
  </div>
</div>