{% set status = businessEntity.getStatus %}
{% set statusLabel = status|capitalize %}
{% set badgeClass = 'badge-' ~ status %}

<div class="business-entity-view-header">
  <div class="business-entity-view-header__main">
    <div class="business-entity-view-avatar" aria-hidden="true">
      {{ businessEntity.getInitials }}
    </div>
    <div class="business-entity-view-header__titles">
      <div class="business-entity-view-header__title">
        <h1 class="business-entity-view-header__name">{{ businessEntity.getName }}</h1>
        <span class="badge {{ badgeClass }}">{{ statusLabel }}</span>
      </div>
      {% if businessEntity.getLegalName %}
        <div class="business-entity-view-header__legal-name">{{ businessEntity.getLegalName }}</div>
      {% endif %}
    </div>
  </div>
</div>
<hr class="business-entity-view-separator">
