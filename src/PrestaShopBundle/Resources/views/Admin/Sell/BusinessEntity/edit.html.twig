{% extends '@PrestaShop/Admin/layout.html.twig' %}

{% form_theme businessEntityForm '@PrestaShop/Admin/TwigTemplateForm/prestashop_ui_kit_base.html.twig' %}

{% macro readonly_address_card(address, loop_first) %}
  <div class="business-entity-edit-address{% if not loop_first %} mt-3{% endif %}">
    <div class="business-entity-edit-address__header d-flex justify-content-between align-items-center mb-3">
      <span>
        <strong>{{ address.getAlias ?: 'Address'|trans({}, 'Admin.Global') }}</strong>
        {% if address.isDefault %}
          <span class="badge business-entity-edit-address__default-badge ml-2">{{ 'Default'|trans({}, 'Admin.Global') }}</span>
        {% endif %}
      </span>
      <i class="material-icons business-entity-edit-address__delete" aria-hidden="true">delete</i>
    </div>
    <div class="row">
      <div class="col-md-6 form-group">
        <label class="form-control-label">{{ 'Label'|trans({}, 'Admin.Global') }}</label>
        <input type="text" class="form-control" value="{{ address.getAlias }}" disabled>
      </div>
      <div class="col-md-6 form-group">
        <label class="form-control-label">{{ 'Country'|trans({}, 'Admin.Global') }}</label>
        <input type="text" class="form-control" value="{{ address.getCountry }}" disabled>
      </div>
    </div>
    <div class="form-group">
      <label class="form-control-label">{{ 'Street address'|trans({}, 'Admin.Global') }}</label>
      <input type="text" class="form-control" value="{{ address.getAddress1 }}" disabled>
    </div>
    <div class="row">
      <div class="col-md-6 form-group">
        <label class="form-control-label">{{ 'City'|trans({}, 'Admin.Global') }}</label>
        <input type="text" class="form-control" value="{{ address.getCity }}" disabled>
      </div>
      <div class="col-md-6 form-group">
        <label class="form-control-label">{{ 'Postal code'|trans({}, 'Admin.Global') }}</label>
        <input type="text" class="form-control" value="{{ address.getPostcode }}" disabled>
      </div>
    </div>
  </div>
{% endmacro %}

{% block content %}
  {{ form_start(businessEntityForm) }}

  <div class="card">
    <h3 class="card-header">
      {{ 'General information'|trans({}, 'Admin.Global') }}
    </h3>
    <div class="card-body">
      <div class="form-wrapper">
        <div class="row">
          <div class="col-md-6">{{ form_row(businessEntityForm.general_information.name) }}</div>
          <div class="col-md-6">{{ form_row(businessEntityForm.general_information.legal_name) }}</div>
        </div>

        {% set identifiers = businessEntity.getIdentifiers %}
        {% if identifiers is not empty %}
          <hr>
          <div class="row">
            {% for identifier in identifiers %}
              <div class="col-md-4">
                <div class="form-group">
                  <label class="form-control-label">{{ identifier.getLabel }}</label>
                  <input type="text" class="form-control" value="{{ identifier.getValue }}" disabled>
                </div>
              </div>
            {% endfor %}
          </div>
        {% endif %}

        <hr>
        <div class="row">
          <div class="col-md-6">{{ form_row(businessEntityForm.general_information.external_ref) }}</div>
        </div>
        <div class="row">
          <div class="col-md-6">{{ form_row(businessEntityForm.general_information.status) }}</div>
          <div class="col-md-6">{{ form_row(businessEntityForm.general_information.customer_group_id) }}</div>
        </div>
        {{ form_row(businessEntityForm.general_information.delivery_authorized) }}
      </div>
    </div>
  </div>

  {% set billingAddresses = businessEntity.getInvoiceAddresses %}
  {% set deliveryAddresses = businessEntity.getDeliveryAddresses %}
  {% set dedicatedShipping = [] %}
  {% for address in deliveryAddresses %}
    {% if address.getAddressType == 'delivery' %}
      {% set dedicatedShipping = dedicatedShipping|merge([address]) %}
    {% endif %}
  {% endfor %}

  <div class="card">
    <h3 class="card-header d-flex justify-content-between align-items-center">
      <span>
        <i class="material-icons">place</i>
        {{ 'Billing address'|trans({}, 'Admin.Global') }}
      </span>
      <button type="button" class="btn btn-outline-secondary">
        <i class="material-icons">add</i>{{ 'Add address'|trans({}, 'Admin.Global') }}
      </button>
    </h3>
    <div class="card-body">
      {% if billingAddresses is empty %}
        <div class="text-muted">{{ 'No billing addresses configured'|trans({}, 'Admin.Orderscustomers.Feature') }}</div>
      {% else %}
        {% for address in billingAddresses %}
          {{ _self.readonly_address_card(address, loop.first) }}
        {% endfor %}
      {% endif %}
    </div>
  </div>

  <div class="card">
    <h3 class="card-header d-flex justify-content-between align-items-center">
      <span>
        <i class="material-icons">place</i>
        {{ 'Shipping address'|trans({}, 'Admin.Global') }}
      </span>
      <button type="button" class="btn btn-outline-secondary">
        <i class="material-icons">add</i>{{ 'Add address'|trans({}, 'Admin.Global') }}
      </button>
    </h3>
    <div class="card-body">
      <div class="custom-control custom-checkbox">
        <input type="checkbox" class="custom-control-input" id="use_billing_as_shipping_display"
               {% if dedicatedShipping is empty %}checked{% endif %}>
        <label class="custom-control-label" for="use_billing_as_shipping_display">
          {{ 'Use billing address as shipping address'|trans({}, 'Admin.Global') }}
        </label>
      </div>

      {% if dedicatedShipping is empty %}
        <hr>
        <div class="text-center text-muted">{{ 'Billing address will be used for shipping.'|trans({}, 'Admin.Global') }}</div>
      {% else %}
        <hr>
        {% for address in dedicatedShipping %}
          {{ _self.readonly_address_card(address, loop.first) }}
        {% endfor %}
      {% endif %}
    </div>
  </div>

  <div class="d-flex justify-content-end">
    <a href="{{ path('admin_business_entities_view', {businessEntityId: businessEntity.businessEntityId}) }}"
       class="btn btn-outline-secondary mr-3">{{ 'Cancel'|trans({}, 'Admin.Actions') }}</a>
    <button class="btn btn-primary">{{ 'Save'|trans({}, 'Admin.Actions') }}</button>
  </div>

  {{ form_widget(businessEntityForm._token) }}
  {{ form_widget(businessEntityForm.default_billing_address) }}
  {{ form_widget(businessEntityForm.default_shipping_address) }}
  {{ form_widget(businessEntityForm.shop_id) }}
  {{ form_end(businessEntityForm, {render_rest: false}) }}

  <div class="mt-3">
    {{ include('@PrestaShop/Admin/Sell/BusinessEntity/Blocks/View/linked_customers.html.twig') }}
  </div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}

  <script src="{{ asset('themes/new-theme/public/business_entities.bundle.js') }}"></script>
{% endblock %}
